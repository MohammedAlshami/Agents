  "workflows": {
    "takeover_document_generation": {
      "name": "Takeover Document Generation",
      "description": "Complete workflow for generating takeover documents",
      "nodes": [
        "project_details",
        "document_loader",
        "variable_extractor",
        "dependency_manager",
        "search_agent",
        "chat_agent",
        "document_generation",
        "markdown_to_file"
      ],
      "flow": [
        {
          "from": "project_details",
          "to": "document_loader",
          "condition": "if_files_exist"
        },
        {
          "from": "document_loader",
          "to": "variable_extractor",
          "condition": "always"
        },
        {
          "from": "variable_extractor",
          "to": "dependency_manager",
          "condition": "always"
        },
        {
          "from": "dependency_manager",
          "to": "search_agent",
          "condition": "if_dependencies_missing"
        },
        {
          "from": "dependency_manager",
          "to": "chat_agent",
          "condition": "if_search_failed"
        },
        {
          "from": "dependency_manager",
          "to": "document_generation",
          "condition": "if_dependencies_met"
        },
        {
          "from": "document_generation",
          "to": "markdown_to_file",
          "condition": "always"
        }
      ]
    }
  },
